{
  "expo": {
    "name": "Smart Shopping",
    "slug": "mobile",
    "version": "1.0.8",
    "owner": "mayhem1960",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#4ade80"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.smartshopping.app",
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#4ade80"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Smart Shopping needs camera access to scan product barcodes.",
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Smart Shopping needs photo library access to add product images.",
          "cameraPermission": "Smart Shopping needs camera access to photograph products."
        }
      ],
      "expo-document-picker",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Smart Shopping needs your location to find nearby store promotions.",
          "locationWhenInUsePermission": "Smart Shopping needs your location to find nearby store promotions."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "c2e0b1cc-7cc2-4dd0-8736-ca01c8bb226f"
      }
    }
  }
}
